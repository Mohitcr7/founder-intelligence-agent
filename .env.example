# All optional. With none of these set the system runs in deterministic mode:
# retrieval, classification, the decision ledger, contradiction detection and
# every authorization control work with no network and no API key.

# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Model selection per vendor
# FA_ANTHROPIC_MODEL=claude-haiku-4-5   # default; claude-sonnet-5 / claude-opus-5 for stronger synthesis
# FA_OPENAI_MODEL=gpt-4.1

# Routing: which providers serve which task role, in order. "deterministic" is
# always appended as the floor even if you leave it out.
# FA_ROUTE_REASON=anthropic,openai,deterministic
# FA_ROUTE_RESEARCH=openai,anthropic,deterministic
# FA_ROUTE_REDTEAM=anthropic,deterministic

# Optional OpenAI-compatible local model (Ollama, llama.cpp, vLLM) for
# air-gapped use; registered as provider "local". Add it to a route to use it.
# FA_LOCAL_URL=http://localhost:11434/v1
# FA_LOCAL_MODEL=llama3.1

# Credentials. Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# FA_ENV=production refuses to start while any of these is unset or still a
# "dev-" placeholder, and disables any intake channel without its own token.
# FA_ENV=production
FA_API_TOKEN=dev-api-token                     # outer lock on every /api/* route
FA_APPROVER_TOKEN=dev-human-console-token      # approve, deny and execute; never given to agents
# One per trusted intake channel (POST /api/ingest/<channel>); upload needs none.
# FA_CONNECTOR_TOKEN_BOARD=...
# FA_CONNECTOR_TOKEN_FOUNDER=...
# FA_CONNECTOR_TOKEN_COMPLIANCE=...
# FA_CONNECTOR_TOKEN_FINANCE=...
# FA_CONNECTOR_TOKEN_ENGINEERING=...
# FA_CONNECTOR_TOKEN_EXTERNAL=...

# Storage. Point the anchor at storage this process cannot overwrite
# (WORM bucket, append-only mount) so a rewritten audit log fails verification.
# FA_VAR_DIR=var
# FA_AUDIT_ANCHOR=var/anchor/audit_heads.jsonl
# FA_AUDIT_ANCHOR_EVERY=25

# Retrieval / safety thresholds
# FA_TOP_K=8
# FA_MIN_EVIDENCE=1.2
# FA_MIN_COVERAGE=0.5
# Dense half of hybrid retrieval: hashing (offline default) | http | none
# FA_EMBEDDINGS=hashing
# FA_EMBEDDINGS_URL=https://api.openai.com/v1
# FA_EMBEDDINGS_MODEL=text-embedding-3-small
# FA_EMBEDDINGS_KEY_ENV=OPENAI_API_KEY
# FA_ACTION_TTL=900
